# Copy to .env (never commit it). Every variable is optional: with none set,
# the app runs with a simulated PayPal and a rules-based planner.

# PayPal REST app credentials (developer.paypal.com → Apps & Credentials).
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
# Webhook ID from the same app, so the server can verify PayPal webhooks.
PAYPAL_WEBHOOK_ID=

# Claude runs the purchasing agent and reads plain-English mandates.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Public URL of this app (PayPal redirects back here). Render sets
# RENDER_EXTERNAL_URL automatically.
PUBLIC_URL=http://localhost:3000

# Required bearer token for external agents (MCP). Set in production.
MANDATE_AGENT_TOKEN=

# Set to false in production to disable "Reset demo".
DEMO_MODE=true
RATE_LIMIT_PER_MIN=240
